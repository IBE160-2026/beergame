{
  "name": "olspillet-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/lint-colours.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:copy": "node scripts/check-copy.mjs",
    "lint:colours": "node scripts/lint-colours.mjs",
    "theme": "node scripts/build-theme.mjs",
    "api:generate": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.ts"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "5.3.1",
    "@tanstack/react-query": "5.105.3",
    "clsx": "2.1.1",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "6.0.3"
    },
    "axe-core": "4.14.0",
    "playwright-core": "1.64.1",
    "rolldown": "1.2.15",
    "@rolldown/pluginutils": "1.0.1"
  }
}
