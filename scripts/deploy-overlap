#!/usr/bin/env python3
"""Deploy overlap check of the connection budget (Story 15.9, NFR-3, NFR-4, AD-24).

    POSTGRES_DB=olspillet scripts/deploy-overlap
    scripts/deploy-overlap --games 8 --concurrency 24 --base http://127.0.0.1:8080

Run from the repository root with the Docker Compose stack up (`docker compose up -d --wait
proxy worker-batch worker-ai`) and the same variables as that stack. It does to the database
what a Railway deploy with overlap does: a second set of processes starts beside the first
(`--scale backend=2 --scale worker-ai=2 --scale worker-batch=2`), and while both sets run it

- plays a batch of scripted Games through `python -m app.sim run` in a `backend` container
  (the runner's own connections are marked `olspillet-sim`: an operator command, outside the
  budget);
- sends parallel `GET /api/health` requests through the proxy (each takes a pooled connection);
- samples `pg_stat_activity` per `application_name` (each service sets `PGAPPNAME`).

Then the second set is stopped. One line per check, `pass` or `FAIL`:
- the second set started (two running containers of each service);
- the simulation exited 0 (every Game finished and its check passed);
- every request answered 200;
- the peak of the services' connections stayed within the overlap budget (`--limit`, the 50 of
  `docs/ops/connection-budget.md`: twice the budget; no migration runs here, so its one
  connection of the pooler need, 51, is not counted);
- no service logged a pool timeout or "too many clients".
Exit 0 only when every line passes, 2 when the stack is not up. Standard library only; no secret
is needed.
"""

import argparse
import concurrent.futures
import http.client
import json
import re
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from datetime import UTC, datetime, timedelta

SERVICES = ("backend", "worker-ai", "worker-batch")
APP_NAMES = {f"olspillet-{service}": service for service in SERVICES}
SIM_APP_NAME = "olspillet-sim"
OVERLAP_LIMIT = 50
"""Twice the budget total (docs/ops/connection-budget.md); a test keeps it equal to
`ops.connection_budget.overlap_total()`."""
COMMAND_TIMEOUT_S = 900
LOG_MARGIN = timedelta(seconds=60)
"""The logs are read from this long before the start, so a Docker clock a little behind the
host's loses no line."""

BATCH = {
    "seed": 1509,
    "games": 6,
    "seats": {
        "retailer": "scripted:order-incoming",
        "wholesaler": "scripted:constant-4",
        "distributor": "scripted:order-incoming",
        "factory": "scripted:constant-4",
    },
}

LOG_PROBLEMS = re.compile(
    r"QueuePool limit|PoolTimeout|too many clients|remaining connection slots",
    re.IGNORECASE,
)
"""A SQLAlchemy pool that ran dry, a procrastinate (psycopg_pool) pool that timed out, Postgres
refusing a connection. Not every timeout: an AI provider's is no connection problem."""
ACTIVITY_SQL = (
    "SELECT application_name, count(*) FROM pg_stat_activity "
    "WHERE datname = current_database() GROUP BY application_name"
)


def parse_activity(text: str) -> dict[str, int]:
    """`psql -At -F '|'` rows of `application_name|count` as a mapping."""
    found: dict[str, int] = {}
    for line in text.splitlines():
        name, sep, count = line.rpartition("|")
        if sep and count.strip().isdigit():
            found[name.strip()] = found.get(name.strip(), 0) + int(count)
    return found


class Peaks:
    """The highest connection counts seen: per service, of the services together, of the sim."""

    def __init__(self) -> None:
        self.per_service = dict.fromkeys(SERVICES, 0)
        self.services = 0
        self.sim = 0
        self.samples = 0

    def add(self, activity: dict[str, int]) -> None:
        self.samples += 1
        together = 0
        for name, service in APP_NAMES.items():
            count = activity.get(name, 0)
            together += count
            self.per_service[service] = max(self.per_service[service], count)
        self.services = max(self.services, together)
        self.sim = max(self.sim, activity.get(SIM_APP_NAME, 0))


def log_problems(text: str) -> list[str]:
    """The log lines that say a connection was refused or a pool ran dry."""
    return [line.strip() for line in text.splitlines() if LOG_PROBLEMS.search(line)]


def verdict(
    *,
    started: dict[str, int],
    sim_exit: int,
    requests: int,
    failed_requests: int,
    peaks: Peaks,
    limit: int,
    problems: list[str],
) -> list[tuple[bool, str]]:
    """One (passed, line) per check."""
    per = ", ".join(f"{s} {peaks.per_service[s]}" for s in SERVICES)
    return [
        (
            all(started.get(s, 0) >= 2 for s in SERVICES),
            "second set started: " + ", ".join(f"{s} {started.get(s, 0)}" for s in SERVICES),
        ),
        (sim_exit == 0, f"simulation exited {sim_exit}"),
        (
            requests > 0 and failed_requests == 0,
            f"requests answered 200: {requests - failed_requests} of {requests}",
        ),
        (
            peaks.samples > 0 and peaks.services <= limit,
            f"peak connections {peaks.services} <= {limit} ({per}; sim {peaks.sim} outside the "
            f"budget; {peaks.samples} samples)",
        ),
        (not problems, f"pool timeouts or refused connections in the logs: {len(problems)}"),
    ]


def compose(*args: str, stdin: str | None = None, check: bool = True):
    return subprocess.run(
        ["docker", "compose", *args],
        input=stdin,
        stdin=None if stdin is not None else subprocess.DEVNULL,
        timeout=COMMAND_TIMEOUT_S,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        check=check,
    )


def running(service: str) -> int:
    out = compose("ps", "--status", "running", "-q", service, check=False).stdout
    return len([line for line in out.splitlines() if line.strip()])


def sample(peaks: Peaks, stop: threading.Event, interval: float) -> None:
    query = f'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -At -F "|" -c "{ACTIVITY_SQL}"'
    while not stop.is_set():
        result = compose("exec", "-T", "postgres", "sh", "-c", query, check=False)
        if result.returncode == 0:
            peaks.add(parse_activity(result.stdout))
        stop.wait(interval)


def health(base: str) -> bool:
    try:
        with urllib.request.urlopen(base + "/api/health", timeout=10) as response:
            return response.status == 200
    except (urllib.error.URLError, http.client.HTTPException, OSError):
        return False


def load(base: str, stop: threading.Event, concurrency: int) -> tuple[int, int]:
    """Parallel health requests until `stop`; (sent, failed)."""
    counts = {"sent": 0, "failed": 0}
    lock = threading.Lock()

    def worker() -> None:
        while not stop.is_set():
            try:
                ok = health(base)
            except Exception:  # never lose a failure with the thread
                ok = False
            with lock:
                counts["sent"] += 1
                counts["failed"] += 0 if ok else 1

    with concurrent.futures.ThreadPoolExecutor(concurrency) as pool:
        for _ in range(concurrency):
            pool.submit(worker)
    return counts["sent"], counts["failed"]


def scale(count: int) -> None:
    """`count` containers of each service; waits until they run (and `backend` is healthy)."""
    args = ["up", "-d", "--no-build", "--no-recreate", "--wait"]
    for service in SERVICES:
        args += ["--scale", f"{service}={count}"]
    compose(*args, *SERVICES)


def main(argv: list[str] | None = None, *, out=sys.stdout) -> int:
    parser = argparse.ArgumentParser(
        prog="scripts/deploy-overlap", description=__doc__.split("\n")[0]
    )
    parser.add_argument("--base", default="http://127.0.0.1:8080", help="the proxy")
    parser.add_argument("--games", type=int, default=BATCH["games"], help="scripted Games (6)")
    parser.add_argument("--concurrency", type=int, default=16, help="parallel requests (16)")
    parser.add_argument("--limit", type=int, default=OVERLAP_LIMIT, help="overlap budget (50)")
    parser.add_argument("--interval", type=float, default=0.5, help="seconds between samples")
    args = parser.parse_args(argv)
    base = args.base.rstrip("/")

    def say(line: str) -> None:
        print(line, file=out, flush=True)

    if not all(running(s) == 1 for s in SERVICES) or not health(base):
        say("the stack is not up with one container per service; start it first")
        return 2
    since = (datetime.now(UTC) - LOG_MARGIN).strftime("%Y-%m-%dT%H:%M:%SZ")
    peaks = Peaks()
    stop_sampling = threading.Event()
    sampler = threading.Thread(
        target=sample, args=(peaks, stop_sampling, args.interval), daemon=True
    )
    sampler.start()
    stop_load = threading.Event()
    result: dict[str, tuple[int, int]] = {}
    sim_exit = -1
    started: dict[str, int] = {}
    try:
        say("starting the second set of processes")
        scale(2)
        started = {s: running(s) for s in SERVICES}
        loader = threading.Thread(
            target=lambda: result.setdefault("load", load(base, stop_load, args.concurrency))
        )
        loader.start()
        say(f"playing {args.games} scripted Games through python -m app.sim run")
        sim = compose(
            "exec", "-T", "--index", "1", "-e", f"PGAPPNAME={SIM_APP_NAME}", "backend",
            "sh", "-c",
            "cat > /tmp/overlap-batch.json && python -m app.sim run /tmp/overlap-batch.json",
            stdin=json.dumps(dict(BATCH, games=args.games)),
            check=False,
        )  # fmt: skip
        sim_exit = sim.returncode
        if sim_exit != 0:
            say(sim.stdout[-2000:] + sim.stderr[-2000:])
        time.sleep(2)  # the load goes on a moment after the last Game
        stop_load.set()
        loader.join()
    finally:
        stop_load.set()
        say("stopping the second set")
        try:
            scale(1)
        except (subprocess.SubprocessError, OSError) as exc:
            say(f"could not stop the second set: {type(exc).__name__}; stop it by hand")
        finally:
            stop_sampling.set()
            sampler.join(timeout=30)
    sent, failed = result.get("load", (0, 0))
    logs = compose("logs", "--no-color", "--since", since, *SERVICES, check=False).stdout
    problems = log_problems(logs)
    for line in problems[:5]:
        say(f"  log: {line[:200]}")
    lines = verdict(
        started=started,
        sim_exit=sim_exit,
        requests=sent,
        failed_requests=failed,
        peaks=peaks,
        limit=args.limit,
        problems=problems,
    )
    for passed, line in lines:
        say(f"{'pass' if passed else 'FAIL'} {line}")
    ok = all(passed for passed, _ in lines)
    say(f"deploy overlap {'ok' if ok else 'FAILED'}")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
