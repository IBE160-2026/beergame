#!/usr/bin/env python3
"""Smoke test of the proxy rules (AD-11, Story 3.14), against any base URL.

    scripts/smoke http://127.0.0.1:8080
    scripts/smoke https://olspillet.example --watch 600 --interval 2

Checks, through the proxy:
- `GET /api/health` answers 200 with {"status": "ok"} (backend and its database);
- `GET /print/smoke` answers 404 and is not a page of the frontend (the print route is
  internal only, AD-18);
- `GET /` answers 200 with an HTML page built by Next.js (`/_next/`), so the frontend serves it.

Every failed request is printed at once, with a UTC time, so the script can watch a deploy:
with `--watch SECONDS` it repeats the checks every `--interval` seconds until the time is up.
The exit code is 0 only when no request failed. Standard library only; no secret is needed.
"""

import argparse
import http.client
import json
import sys
import time
import urllib.error
import urllib.request
from datetime import UTC, datetime

TIMEOUT_S = 10


def fetch(url: str) -> tuple[int, str]:
    request = urllib.request.Request(url, headers={"User-Agent": "olspillet-smoke"})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT_S) as response:
            return response.status, response.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read().decode("utf-8", "replace")


def check_health(base: str) -> str | None:
    status, body = fetch(base + "/api/health")
    if status != 200:
        return f"/api/health answered {status}, expected 200"
    try:
        ok = json.loads(body).get("status") == "ok"
    except (ValueError, AttributeError):
        ok = False
    return None if ok else '/api/health did not answer {"status": "ok"}'


def check_print(base: str) -> str | None:
    status, body = fetch(base + "/print/smoke")
    if status != 404:
        return f"/print/smoke answered {status}, expected 404"
    if "/_next/" in body:
        return "/print/smoke answered 404 from the frontend, not from the proxy"
    return None


def check_frontend(base: str) -> str | None:
    status, body = fetch(base + "/")
    if status != 200:
        return f"/ answered {status}, expected 200"
    if "<html" not in body.lower() or "/_next/" not in body:
        return "/ is not a page served by the frontend (no Next.js assets)"
    return None


CHECKS = (check_health, check_print, check_frontend)


def run_once(base: str, report) -> int:
    """Run every check once; returns the number of failed requests."""
    failed = 0
    for check in CHECKS:
        try:
            problem = check(base)
        except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError) as exc:
            problem = f"{check.__name__.removeprefix('check_')}: request failed ({exc})"
        if problem:
            failed += 1
            report(problem)
    return failed


def main(argv: list[str] | None = None, *, out=sys.stdout, sleep=time.sleep, clock=time.monotonic):
    parser = argparse.ArgumentParser(prog="scripts/smoke", description=__doc__.split("\n")[0])
    parser.add_argument("base_url", help="for example http://127.0.0.1:8080")
    parser.add_argument("--watch", type=float, default=0, help="repeat for this many seconds")
    parser.add_argument("--interval", type=float, default=2, help="seconds between rounds (2)")
    args = parser.parse_args(argv)
    base = args.base_url.rstrip("/")

    def report(problem: str) -> None:
        stamp = datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
        print(f"{stamp} FAIL {problem}", file=out, flush=True)

    rounds = failed = 0
    deadline = clock() + args.watch
    while True:
        rounds += 1
        failed += run_once(base, report)
        if clock() >= deadline:
            break
        sleep(args.interval)
    requests = rounds * len(CHECKS)
    verdict = "ok" if failed == 0 else "FAILED"
    print(f"smoke {verdict}: {failed} of {requests} requests failed against {base}", file=out)
    return 0 if failed == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
