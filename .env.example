# Variable names only. Locally nothing is required (every value has a
# default, every integration a mock). A .env file feeds docker compose only;
# the backend reads real environment variables, not .env.
# Never commit real values.

# backend, worker-ai and worker-batch
APP_ENV=
DATABASE_URL=
DB_POOL_SIZE=
# The Supabase pooler pool size, copied by hand (Story 15.9); empty = not checked.
DB_POOLER_SIZE=
LOG_LEVEL=
RUN_MIGRATIONS=
BCRYPT_ROUNDS=
TRUSTED_PROXY_CIDRS=

# Required with APP_ENV=production; the api and workers refuse to start without them (AD-17)
JWT_SECRET=
PUBLIC_BASE_URL=
EMAIL_FROM=
RESEND_API_KEY=
# Resend webhook signing secret (whsec_...), Story 4.6
RESEND_WEBHOOK_SECRET=
BOOTSTRAP_ADMIN_EMAILS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The error tracker (Story 15.11): https://<key>@<host>/<project>, any tracker that accepts
# Sentry envelopes. Empty: a recording mock locally, a log line in production (issue #28)
ERROR_TRACKER_DSN=

# AI cost (FR-69): the daily spend that alerts every Admin, a placeholder until the
# prototype (issue #8, Story 15.7); set it empty to send no daily alert
# AI_DAILY_ALERT_USD=25.00

# Cut-list feature flags (PRD Â§8.1, AD-17); default true locally
FEATURE_STUDENT_CHOICE=
FEATURE_CROSS_INSTITUTION_STATS=
FEATURE_RERUN=
FEATURE_INFO_VISIBILITY=
FEATURE_LECTURER_TEST_GAME=
FEATURE_GAME_DATA_EXPORT=
FEATURE_CAPACITY=

# frontend
API_INTERNAL_URL=

# proxy
PORT=
API_UPSTREAM=
WEB_UPSTREAM=

# docker compose
COMPOSE_PROJECT_NAME=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
HTTP_PORT=
