# Variable names only. Locally nothing is required (every value has a
# default, every integration a mock). A .env file feeds docker compose only;
# the backend reads real environment variables, not .env.
# Never commit real values.

# backend (and later the workers)
APP_ENV=
DATABASE_URL=
DB_POOL_SIZE=
LOG_LEVEL=
RUN_MIGRATIONS=

# Cut-list feature flags (PRD Â§8.1, AD-17); default true locally
FEATURE_STUDENT_CHOICE=
FEATURE_CROSS_INSTITUTION_STATS=
FEATURE_RERUN=
FEATURE_INFO_VISIBILITY=
FEATURE_LECTURER_TEST_GAME=
FEATURE_GAME_DATA_EXPORT=
FEATURE_CAPACITY=

# frontend
API_INTERNAL_URL=

# proxy
PORT=
API_UPSTREAM=
WEB_UPSTREAM=

# docker compose
COMPOSE_PROJECT_NAME=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
HTTP_PORT=
