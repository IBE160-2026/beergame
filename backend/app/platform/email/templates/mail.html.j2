{# The HTML part of every mail. Colours are DESIGN.md's tokens, inline, since mail clients
   read no stylesheet: paper #FFFFFF, ink #0F2A47, ink-secondary #44586F, hairline #E1E6EC,
   links in lager #2B6CA3. #}
<!doctype html>
<html lang="nb">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#FFFFFF;color:#0F2A47;font-family:'Source Sans 3','Source Sans Pro',Arial,sans-serif;font-size:16px;line-height:1.5;">
<div style="max-width:560px;margin:0 auto;padding:24px 16px;">
<p style="margin:0 0 16px;font-size:20px;font-weight:700;">ØL-spillet</p>
<p style="margin:0 0 16px;">Hei{% if name %} {{ name }}{% endif %},</p>
{% for part in parts %}
<div style="border-top:1px solid #E1E6EC;padding:16px 0 0;margin:0 0 16px;">
{{ part | safe }}
</div>
{% endfor %}
<p style="margin:24px 0 0;border-top:1px solid #E1E6EC;padding-top:16px;color:#44586F;">Hilsen <a href="{{ url('/') }}" style="color:#2B6CA3;font-weight:600;">ØL-spillet</a><br>Denne e-posten er sendt automatisk. Svar på den blir ikke lest.</p>
</div>
</body>
</html>
